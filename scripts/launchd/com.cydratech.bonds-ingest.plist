<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  macOS launchd agent for the daily bonds ingest.

  StartCalendarInterval fires at 13:00 local (midday: the machine is reliably awake, unlike
  21:00 where laptop sleep repeatedly stretched runs across the night). Most sources publish
  after the close — FBIL ~19:00, CCIL and BSE after 17:00 — so a midday run ingests the PREVIOUS
  business day and the current day lands tomorrow.

  That is only safe because a source with nothing to give records `skipped` and is re-attempted.
  A connector that reports `success` with zero rows, or that lands an empty artifact in the data
  lake, turns this schedule into silent permanent data loss: catch-up resumes from the last
  SUCCESSFUL run, so the day is never revisited. Exactly that cost three weeks of the CCIL
  sovereign tape and the BSE corporate tape in August 2026. `bonds dq assess` now fails on both
  signatures — do not weaken those checks to make this schedule look green.

  If the Mac is asleep or powered off at that time,
  launchd runs the missed job once when the machine next wakes/boots — that single run's
  `catch-up` command then gap-fills every business day that was missed. RunAtLoad also triggers
  a run at login, so a freshly-booted machine catches up immediately.

  Edit the absolute paths below if you move the repo. See scripts/README.md to install.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.cydratech.bonds-ingest</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/jeevanprakash/work/cydratech/bonds-research/scripts/run_daily_ingest.sh</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/jeevanprakash/work/cydratech/bonds-research</string>

  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>13</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>

  <key>RunAtLoad</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/Users/jeevanprakash/work/cydratech/bonds-research/data/logs/launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/jeevanprakash/work/cydratech/bonds-research/data/logs/launchd.err.log</string>

  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>
